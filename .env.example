# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI or Vercel Environment Variables.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional client-side fallback key for static hosting
VITE_GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ==============================================================================
# FIREBASE SERVER-SIDE AUTHENTICATION & ADMIN SDK CONFIGURATION
# ==============================================================================
# All sensitive backend endpoints (/api/config, /api/google, /api/history, /api/push, /api/ai)
# require a valid Firebase ID Token passed in "Authorization: Bearer <Firebase-ID-Token>".
# The server verifies the token via Firebase Admin SDK.
# Firebase Admin SDK uses GOOGLE_SERVICE_ACCOUNT_JSON (defined below) as unified credentials.
# Project ID: Automatically read from firebase-applet-config.json if omitted.
FIREBASE_PROJECT_ID="gen-lang-client-0520605273"

# ==============================================================================
# GOOGLE SERVER-SIDE OAUTH REFRESH TOKEN CONFIGURATION
# ==============================================================================
# (Auto-renews, no 60-min expiration, uploads directly to Admin Google Drive)
GOOGLE_REFRESH_TOKEN=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ==============================================================================
# GOOGLE SERVICE ACCOUNT CONFIGURATION (Secondary fallback)
# ==============================================================================
# Option 1: Full JSON string of service account key file
GOOGLE_SERVICE_ACCOUNT_JSON=""

# Option 2: Individual credentials
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_PRIVATE_KEY=""

# ==============================================================================
# WEB PUSH NOTIFICATION (VAPID Keys for Service Worker Push Event)
# ==============================================================================
# Built-in verified fallback keys are already configured in code, but can be customized in Vercel:
VAPID_PUBLIC_KEY="BDaE9PDK_zk-N01Z9A8YQJ_CG96fqYXjNauVDSkln--2PghmKH5i8a8cMaywxemknjae9oPuqlknIt-nonGKTnk"
VAPID_PRIVATE_KEY="iaI-S4gtd8D0OlnNgnkcm04I1AxJq67FxZ1V6QY_PDM"
VAPID_SUBJECT="mailto:depotel@vgd4.my.id"
VITE_VAPID_PUBLIC_KEY="BDaE9PDK_zk-N01Z9A8YQJ_CG96fqYXjNauVDSkln--2PghmKH5i8a8cMaywxemknjae9oPuqlknIt-nonGKTnk"
