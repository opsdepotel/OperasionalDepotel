# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI or Vercel Environment Variables.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional client-side fallback key for static hosting
VITE_GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GOOGLE SERVER-SIDE OAUTH REFRESH TOKEN CONFIGURATION (Auto-renews, no 60-min expiration, uploads directly to Admin Google Drive)
GOOGLE_REFRESH_TOKEN=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# GOOGLE SERVICE ACCOUNT CONFIGURATION (Secondary fallback)
# Option 1: Full JSON string of service account key file
GOOGLE_SERVICE_ACCOUNT_JSON=""

# Option 2: Individual credentials
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_PRIVATE_KEY=""


